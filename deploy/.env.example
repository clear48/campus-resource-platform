# 复制为 deploy/.env 后再填写。真实密码和密钥不得提交到 Git。
COMPOSE_PROJECT_NAME=campus-resource-platform
HTTP_PORT=80

# 本地或 CI 构建出的镜像标签；服务器应加载这些镜像后使用 --no-build 启动。
BACKEND_IMAGE=campus-resource-platform-backend:deploy-02
FRONTEND_IMAGE=campus-resource-platform-frontend:deploy-02

# 以下四项必须替换为空间独立的强随机值；应用账号禁止使用 root。
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USERNAME=campus_app
MYSQL_APP_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

JWT_EXPIRATION_SECONDS=7200
RANK_DOWNLOAD_DELTA_SYNC_ENABLED=true
RANK_HOT_RANKING_SYNC_ENABLED=true

# 2 GB 演示服务器的起步资源预算，合计约 1.5 GB，余量留给系统和 Docker。
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError
BACKEND_MEMORY_LIMIT=768m
MYSQL_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=160m
NGINX_MEMORY_LIMIT=64m

# 数据服务内部预算应低于容器限制，为连接、线程和进程本身保留空间。
HIKARI_MAXIMUM_POOL_SIZE=8
HIKARI_MINIMUM_IDLE=2
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=30
REDIS_MAXMEMORY=96mb
